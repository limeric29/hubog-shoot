# Meta Model API key from https://dev.meta.ai/ (Meta's own name for it).
MODEL_API_KEY=

# Cloudflare Turnstile keys. The site key is public; the secret stays server-side.
TURNSTILE_ENABLED=false
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=shoot.hubog.app

# Model IDs can be changed without editing source. These are the defaults.
META_API_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1
MUSE_VOICE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Route Spark (shot planning + photo checks) to a separately billed
# OpenAI-compatible endpoint, e.g. Baseten's Muse Spark Open for the hackathon:
# MUSE_SPARK_BASE_URL=https://inference.baseten.co/v1 with
# MUSE_SPARK_MODEL=meta-models/muse-spark-open-1026. Leave MUSE_SPARK_BASE_URL
# empty to use the Meta endpoint above.
MUSE_SPARK_BASE_URL=
MUSE_SPARK_API_KEY=

# Optional pricing overrides used by the spend log and SPEND_CAP_USD guard.
# Spark pricing is ignored when MUSE_SPARK_BASE_URL is set (separately billed).
MUSE_SPARK_INPUT_USD_PER_MILLION=1.25
MUSE_SPARK_OUTPUT_USD_PER_MILLION=4.25
MUSE_IMAGE_USD_PER_IMAGE=0.01
SAM_USD_PER_IMAGE=0.0025
MUSE_VOICE_USD_PER_HOUR=0.18
