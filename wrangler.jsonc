// Hubog Shoot on Cloudflare Workers, through the OpenNext adapter (`npm run cf:build` builds .open-next/).
// Vars and secrets reach the app as process.env.
// Secrets (never here): MODEL_API_KEY, TURNSTILE_SECRET.
// MUSE_SPARK_API_KEY is only needed when MUSE_SPARK_BASE_URL routes Spark away.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hubog-shoot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "shoot.hubog.app", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": false },
  "d1_databases": [{ "binding": "DB", "database_name": "hubog-shoot", "database_id": "96d04ed1-9e19-4518-947c-cfde0d5f0a87", "migrations_dir": "migrations" }],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "vars": {
    // Stops every paid call once this instance has spent this much (USD). Set HUBOG_KILL to "1" to pause them all.
    "SPEND_CAP_USD": "40",
    "META_API_BASE_URL": "https://api.meta.ai/v1",
    "ANIMATE_URL": "https://limeric29--hubog-shoot-animate-web.us-east.modal.run",
    "MUSE_SPARK_MODEL": "muse-spark-1.3",
    "MUSE_SPARK_OPEN_BASE_URL": "https://inference.baseten.co/v1",
    "MUSE_SPARK_OPEN_MODEL": "meta-models/muse-spark-open-1026",
    "MUSE_IMAGE_MODEL": "muse-image-1.0",
    "SAM_MODEL": "sam-3.1",
    "MUSE_VOICE_TRANSCRIBE_MODEL": "muse-voice-transcribe-1.0",
    "MUSE_SPARK_INPUT_USD_PER_MILLION": "1.25",
    "MUSE_SPARK_OUTPUT_USD_PER_MILLION": "4.25",
    "MUSE_IMAGE_USD_PER_IMAGE": "0.01",
    "SAM_USD_PER_IMAGE": "0.0025",
    "MUSE_VOICE_USD_PER_HOUR": "0.18",
    "TURNSTILE_ENABLED": "true",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFtTm2cPGOof09MP",
    "TURNSTILE_HOSTNAMES": "shoot.hubog.app"
  },
  "secrets": { "required": ["MODEL_API_KEY", "TURNSTILE_SECRET"] }
}
